{
  "manifest_version": 3,
  "name": "Profile Router",
  "version": "0.1",
  "description": "Routes Chrome links to the correct profile via ProfilePrism app",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Profile Router"
  }
}
