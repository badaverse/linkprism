    "atlassian.net" : {

    },
    "Auto-select Chrome profile by domain" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "도메인별 Chrome 프로필 자동 선택"
          }
        }
      }
    },
    "Automatically routes URLs to the right\nChrome profile based on domain rules." : {
      "extractionState" : "stale",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "도메인 규칙에 따라 URL을 올바른\nChrome 프로필로 자동 라우팅합니다."
          }
        }
      }
    },
    "Cancel" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "취소"
          }
        }
      }
    },
    "Check for Updates" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "업데이트 확인"
          }
        }
      }
    },
    "Chrome Extension" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chrome 확장 프로그램"
          }
        }
      }
    },
    "Chrome handles link clicks internally, so macOS default browser settings alone cannot redirect links clicked within Chrome to LinkPrism." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chrome은 내부적으로 링크 클릭을 직접 처리하기 때문에, macOS 기본 브라우저 설정만으로는 Chrome 내부에서 클릭한 링크를 LinkPrism으로 전달할 수 없습니다."
          }
        }
      }
    },
    "Chrome Profile Directory" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
