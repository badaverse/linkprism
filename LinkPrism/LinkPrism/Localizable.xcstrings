{
  "sourceLanguage" : "en",
  "strings" : {
    "" : {

    },
    "\"Ask\" mode to choose profile each time" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"물어보기\" 모드로 매번 프로필 선택 가능"
          }
        }
      }
    },
    "*.atlassian.net" : {

    },
    "%lld" : {

    },
    "1. Open chrome://extensions in Chrome." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Chrome에서 chrome://extensions 페이지를 엽니다."
          }
        }
      }
    },
    "2. Enable \"Developer mode\"." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. \"개발자 모드\"를 활성화합니다."
          }
        }
      }
    },
    "3. Click \"Load unpacked\"." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. \"압축해제된 확장 프로그램을 로드합니다\" 버튼을 클릭합니다."
          }
        }
      }
    },
    "4. Select the LinkPrism extension folder." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4. LinkPrism 확장 프로그램 폴더를 선택합니다."
          }
        }
      }
    },
    "A macOS menu bar app that automatically\nroutes URLs to the right Chrome profile." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL을 자동으로 올바른 Chrome 프로필로\n라우팅하는 macOS 메뉴바 앱입니다."
          }
        }
      }
    },
    "About" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "정보"
          }
        }
      }
    },
