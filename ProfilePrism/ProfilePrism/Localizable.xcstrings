          }
        }
      }
    },
    "You're up to date" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최신 버전입니다"
          }
        }
      }
    },
    "You're running the latest version." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 사용 중인 버전이 최신입니다."
          }
        }
      }
    },
    "OK" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "확인"
          }
        }
      }
    },
    "Update Available" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 버전이 있습니다"
          }
        }
      }
    },
    "ProfilePrism %@ is available for download.\n\n%@" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ProfilePrism %@ 버전을 다운로드할 수 있습니다.\n\n%@"
          }
        }
      }
    },
    "Download" : {
      "localizations" : {
